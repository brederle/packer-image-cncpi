# DO NOT EDIT THIS FILE but add config options to /etc/default/armbian-motd
# any changes will be lost on board support package update

HOSTNAME=$(/usr/bin/hostname)

USER=armour
USERHOME=$(eval echo "~$USER")

CNCJSUSER=cncjs
CNCJSUSERHOME=$(eval echo "~$CNCJSUSER")

set -e
# USING ANSI COLORS
BLUE="\e[94m"
LOGO=$(/usr/bin/figlet -f smslant "${HOSTNAME}")
STOP="\e[0m"
printf "${BLUE}${LOGO}${STOP}\n"

# show the board name
if [[ -f /proc/cpuinfo ]]; then
    BOARD_NAME=$(sed -n 's/^Model\s*:\s*//p' /proc/cpuinfo)
    printf "${BOARD_NAME} - "
fi

# show the OS name (pretty)
[[ -f /etc/os-release ]] && . /etc/os-release
if [[ ! -z ${PRETTY_NAME:-} ]]; then
    printf " ${PRETTY_NAME}\n"
else
    printf "\n"
fi

[[ -f /var/cache/apt/archives/updates.number ]] && . /var/cache/apt/archives/updates.number
if [[ ${NUM_UPDATES:-} -gt 0 ]]; then
    printf "Last OS update ${DATE} (${NUM_UPDATES} packages)\n"
fi

# node.js version
if [[ -f /usr/bin/node ]]; then
    NODEVERSION=$(/usr/bin/node -v)
    printf "node.js ${NODEVERSION}"
fi

# cnc.js version
if [[ -f ${CNCJSUSERHOME}/.npm/bin/cncjs ]]; then
    CNCJSVERSION=$(${CNCJSUSERHOME}/.npm/bin/cncjs --version)
    printf ", cnc.js ${CNCJSVERSION}"
fi

# marlin build version
if [[ -f ${USERHOME}/marlin/platformio.ini ]]; then
    MARLINVERSION=$(grep -oP '(?<=#define SHORT_BUILD_VERSION ")[^"]+' ${USERHOME}/marlin/Marlin/Version.h)
    printf ", Marlin ${MARLINVERSION}\n\033[90m// Marlin build:\n// cd ${USERHOME}/marlin; ${USERHOME}/platformio/.venv/bin/pio run\033[0m\n"
else
    printf "\n"
fi



